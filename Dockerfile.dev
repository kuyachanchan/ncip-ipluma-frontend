FROM node:20-alpine

WORKDIR /app

RUN addgroup -g 1001 app && \
    adduser -u 1001 -S -G app -s /bin/sh app && \
    mkdir -p /app/node_modules && \
    chown -R app:app /app

USER app

COPY --chown=app:app package*.json ./
RUN npm install
COPY --chown=app:app . .

EXPOSE 5173
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]